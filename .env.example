# RPC endpoints
MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Deployment
DEPLOYER_PRIVATE_KEY=0x...
ETHERSCAN_MAINNET_KEY=...

# Admin (receives DEFAULT_ADMIN_ROLE on all contracts)
ADMIN_ADDRESS=0x...

# Whitelisted wallets (comma-separated, up to 10)
WHITELISTED_WALLETS=0x...,0x...

# KyberSwap router address (query via script/kyberswap/quote.ts first)
KYBERSWAP_ROUTER=0x6131B5fae19EA4f9D964eAc0408E4408b66337b5

# Flash loan provider (ERC7399 wrapper, e.g. Balancer)
FLASH_LOAN_PROVIDER=0x...

# Trade limits (0 = unlimited)
MAX_TRADE_SIZE=0
MAX_DAILY_VOLUME=0
MAX_OPEN_POSITIONS=0
